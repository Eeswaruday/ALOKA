{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]}],
  "rewrites": [
    {"source":"/api/:path*","destination":"https://aloka-admin-api-eeswaruday.onrender.com/api/:path*"},
    {"source":"/admin/login","destination":"/admin/login/index.html"},
    {"source":"/admin/dashboard","destination":"/admin/dashboard/index.html"}
  ]
}
