# Public frontend configuration. Vanilla static files do not read .env at runtime;
# set Clerk's public key in js/clerk-config.js or configure an explicit build step.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_publishable_key

# PHP backend only. Keep these values in the PHP host's protected environment.
CLERK_SECRET_KEY=sk_test_replace_with_server_secret
CLERK_AUTHORIZED_ADMIN_IDS=replace_with_authorized_ids_if_implemented
ADMIN_ENABLED=0
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_php_password_hash
ADMIN_FORCE_PASSWORD_CHANGE=1
ALOKA_PRIVATE_DIR=/path/outside/webroot/aloka-admin
ALLOWED_FRONTEND_ORIGINS=https://your-project.vercel.app
GITHUB_TOKEN=github_pat_replace_with_fine_grained_token
GITHUB_REPOSITORY_OWNER=Eeswaruday
GITHUB_REPOSITORY_NAME=ALOKA
GITHUB_PRODUCTION_BRANCH=main
GITHUB_DRAFT_BRANCH=aloka-drafts
RESEND_API_KEY=re_replace_with_server_api_key
RESEND_FROM_EMAIL=ALOKA <noreply@example.com>
