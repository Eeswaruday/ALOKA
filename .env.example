# Public browser configuration. Set in js/clerk-config.js, not read from this file.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Protected PHP host environment only. Never commit real values.
ADMIN_ENABLED=0
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_php_password_hash
ADMIN_FORCE_PASSWORD_CHANGE=1
ALOKA_PRIVATE_DIR=/absolute/path/outside/webroot/aloka-admin
ALLOWED_FRONTEND_ORIGINS=https://your-site.example
GITHUB_TOKEN=github_pat_replace_with_fine_grained_token
GITHUB_REPOSITORY_OWNER=your-github-owner
GITHUB_REPOSITORY_NAME=your-repository
GITHUB_PRODUCTION_BRANCH=main

# Optional integrations; unused by the current admin workflow.
CLERK_SECRET_KEY=sk_test_replace_me
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=ALOKA <noreply@example.com>
